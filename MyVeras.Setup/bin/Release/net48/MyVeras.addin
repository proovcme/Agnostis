<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Command">
    <Name>MyVeras AI Rendering</Name>
    <Assembly>MyVeras.RevitAPI.dll</Assembly>
    <ClientId>MyVeras-Revit-Plugin</ClientId>
    <FullClassName>MyVeras.RevitAPI.ShowMainWindowCommand</FullClassName>
    <Text>MyVeras AI</Text>
    <Description>AI-powered rendering plugin for Revit with local and cloud processing</Description>
    <VisibilityMode>AlwaysVisible</VisibilityMode>
    <LanguageType>English_USA</LanguageType>
    <Vendor>Cascade AI</Vendor>
    <VendorDescription>Advanced AI solutions for AEC industry</VendorDescription>
  </AddIn>
</RevitAddIns>
