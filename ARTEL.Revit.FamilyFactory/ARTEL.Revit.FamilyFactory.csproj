<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ARTEL.Revit.FamilyFactory</AssemblyName>
    <RootNamespace>ARTEL.Revit.FamilyFactory</RootNamespace>
    <!-- Revit 2025 target (.NET 8). RevitAPI.dll is a .NET 8 assembly here. -->
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Revit 2024 is .NET Framework 4.8. Autodesk ships the JSON runtime with
       Dynamo; referencing that host payload avoids adding a new NuGet dependency. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Text.Json">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Text.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Text.Encodings.Web">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Text.Encodings.Web.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Memory.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Buffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>$(RevitInstallDir)\AddIns\DynamoForRevit\DynamoFeatureFlags\System.Threading.Tasks.Extensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\gen32.png" />
    <EmbeddedResource Include="Resources\gen16.png" />
    <EmbeddedResource Include="Resources\val32.png" />
    <EmbeddedResource Include="Resources\val16.png" />
    <EmbeddedResource Include="Resources\ext32.png" />
    <EmbeddedResource Include="Resources\ext16.png" />
  </ItemGroup>
</Project>
